# ── webpro-portfolio — variables de entorno ─────────────────
# Copia este archivo a `.env`  →  Copy-Item .env.example .env

# URL del CMS WebPro (OPCIONAL).
# Si la dejas vacía, el sitio usa el contenido de apps/storefront/src/lib/site.js
# Si la completas, el build lee servicios y ajustes desde el CMS.
WEBPRO_CMS_URL=

# ── Solo si montás el CMS en este proyecto ──────────────────
# PORT=3001
# DATABASE_URL="file:./prisma/webpro.db"
# IG_ACCESS_TOKEN=
# IG_USER_ID=
# IG_HANDLE=
