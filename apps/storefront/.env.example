# Storefront — variables de build
# Copiá a `.env` para desarrollo local (o cargala como variable de entorno en el hosting).

# URL del CMS (OPCIONAL).
#   - Vacío  → el sitio usa el contenido de src/lib/site.js
#   - Con URL → el build lee servicios y ajustes desde el CMS
#               (si el CMS no responde, usa site.js y NO se rompe)
#
# El prefijo WEBPRO_ está expuesto a propósito (envPrefix en astro.config /
# vite.config) para que el storefront pueda leerlo. NO es un secreto.
WEBPRO_CMS_URL=http://localhost:3001
